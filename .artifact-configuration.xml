<?xml version="1.0" encoding="utf-8" ?>
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <!-- Define that the uploaded artifact is a ZIP file -->
  <zip-file>
    <pe-file-set>
      <!-- Inside this uploaded ZIP file sign three PE files with Authenticode
           (PE = Portable Executable, e.g., .exe or .dll file) -->
      <include path="artifacts/WelsonJS.ManagedObject.dll" />
      <include path="artifacts/WelsonJS.Service.exe" />
      <include path="artifacts/WelsonJS.Launcher.exe" />
      <include path="artifacts/WelsonJS.Esent.dll" />
      <include path="artifacts/Esent.Interop.dll" />
      <include path="artifacts/ChakraCore.dll" />
      <include path="artifacts/welsonjs_setup.exe" />
      <include path="artifacts/Catswords.Phantomizer.dll" />
      <include path="artifacts/welsonjs-hta.exe" />
      <include path="artifacts/welsonjs-hta-webview2.exe" />
      <include path="artifacts/welsonjs-hta-edgehtml.exe" />
      <include path="artifacts/welsonjs-hta-mshtml.exe" />
      <!-- llama.cpp (native/llamacpp/build-llamacpp.ps1, built in the Release job) -->
      <include path="artifacts/llamacpp/x64/llama-server.exe" />
      <include path="artifacts/llamacpp/x64/llama-cli.exe" />
      <include path="artifacts/llamacpp/x64/llama-quantize.exe" />
      <include path="artifacts/llamacpp/x64/llama.dll" />
      <include path="artifacts/llamacpp/x64/llama-common.dll" />
      <include path="artifacts/llamacpp/x64/llama-server-impl.dll" />
      <include path="artifacts/llamacpp/x64/llama-cli-impl.dll" />
      <include path="artifacts/llamacpp/x64/llama-quantize-impl.dll" />
      <include path="artifacts/llamacpp/x64/mtmd.dll" />
      <include path="artifacts/llamacpp/x64/ggml.dll" />
      <include path="artifacts/llamacpp/x64/ggml-base.dll" />
      <!-- one CPU backend per CPU variant (GGML_CPU_ALL_VARIANTS); the set depends on the compiler -->
      <include path="artifacts/llamacpp/x64/ggml-cpu-*.dll" min-matches="1" max-matches="unbounded" />
      <for-each>
        <authenticode-sign />
      </for-each>
    </pe-file-set>
    <nupkg-file path="artifacts/WelsonJS.ManagedObject.*.nupkg">
      <directory path="lib">
        <pe-file-set>
          <include path="net20/WelsonJS.ManagedObject.dll" />
          <for-each>
            <authenticode-sign />
          </for-each>
        </pe-file-set>
      </directory>
      <!--<nuget-sign />-->
    </nupkg-file>
  </zip-file>
</artifact-configuration>