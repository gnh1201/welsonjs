 endif()
+
+# Windows icon for the tool executables: set LLAMA_WIN_ICON to an .ico file.
+set(LLAMA_WIN_ICON "" CACHE FILEPATH "llama: .ico file embedded in the Windows tool executables")
+
+function(llama_collect_executables dir out)
+    get_property(targets DIRECTORY "${dir}" PROPERTY BUILDSYSTEM_TARGETS)
+    set(result "")
+    foreach (target IN LISTS targets)
+        get_target_property(type ${target} TYPE)
+        if (type STREQUAL "EXECUTABLE")
+            list(APPEND result ${target})
+        endif()
+    endforeach()
+    get_property(subdirs DIRECTORY "${dir}" PROPERTY SUBDIRECTORIES)
+    foreach (subdir IN LISTS subdirs)
+        llama_collect_executables("${subdir}" sub)
+        list(APPEND result ${sub})
+    endforeach()
+    set(${out} ${result} PARENT_SCOPE)
+endfunction()
+
+if (WIN32 AND LLAMA_WIN_ICON)
+    if (NOT EXISTS "${LLAMA_WIN_ICON}")
+        message(FATAL_ERROR "LLAMA_WIN_ICON does not exist: ${LLAMA_WIN_ICON}")
+    endif()
+    # Copy the icon next to the resource script, which is UTF-8, so a path with
+    # non-ASCII characters does not depend on the ANSI code page.
+    configure_file("${LLAMA_WIN_ICON}" "${CMAKE_CURRENT_BINARY_DIR}/llama-icon.ico" COPYONLY)
+    file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/llama-icon.rc"
+        "#pragma code_page(65001)\n1 ICON \"${CMAKE_CURRENT_BINARY_DIR}/llama-icon.ico\"\n")
+    llama_collect_executables("${CMAKE_CURRENT_SOURCE_DIR}" llama_tool_executables)
+    foreach (target IN LISTS llama_tool_executables)
+        target_sources(${target} PRIVATE "${CMAKE_CURRENT_BINARY_DIR}/llama-icon.rc")
+    endforeach()
+    message(STATUS "Windows icon ${LLAMA_WIN_ICON}: ${llama_tool_executables}")
+endif()
