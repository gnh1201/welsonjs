From: WelsonJS
Subject: [PATCH] ggml-cpu : fix the non-AVX2 I2_S fallbacks

The I2_S kernels are correct only on their AVX2 path. On CPUs without AVX2
(and in the x64, sse42 and sandybridge variants of GGML_CPU_ALL_VARIANTS)
microsoft/BitNet-b1.58-2B-4T-gguf generated only "?" tokens:

  - ggml_vec_dot_i2_i8_s (quants.c): the scalar fallback read the 2-bit
    codes sequentially, while I2_S interleaves 128 weights per 32 bytes
    (byte gp holds weights gp, gp+32, gp+64, gp+96 in bits 7-6, 5-4, 3-2,
    1-0, as in dequantize_row_i2_s); it mapped the codes to -1/0/+1, while
    the callers subtract the activation sum themselves (the AVX2 code uses the
    unsigned codes 0/1/2); and it addressed row r at r * (n/4) instead of
    r * bx / 4. Rewrite it to compute what the AVX2 code computes.
  - ggml_gemm_i2_i8_s (ggml-cpu-i2s.c): with ACT_PARALLEL (set by
    gemm-config.h) the fallback called ggml_vec_dot_i2_i8_s as if it iterated
    over activation columns with an output stride; it iterates over weight
    rows and writes them consecutively. Call it once per activation column,
    which gives the AVX2 code's layout s[col * bs + row].

With both changes the x64 variant generates the same tokens as the AVX2
variants.

Apply with: git -c core.autocrlf=false apply <this file>

diff --git a/ggml/src/ggml-cpu/ggml-cpu-i2s.c b/ggml/src/ggml-cpu/ggml-cpu-i2s.c
index d2ea0d7..59c0f72 100644
--- a/ggml/src/ggml-cpu/ggml-cpu-i2s.c
+++ b/ggml/src/ggml-cpu/ggml-cpu-i2s.c
@@ -180,40 +180,14 @@ void ggml_gemm_i2_i8_s(int n, float * GGML_RESTRICT s, size_t bs, const void * G
         }
     }
 #else
-    // Scalar / non-AVX2 fallback: use vec_dot row by row
-    const int64_t row_block = ROW_BLOCK_SIZE;
-    const int64_t col_block = COL_BLOCK_SIZE;
-
-#if defined(ACT_PARALLEL)
-    for (int64_t c0 = 0; c0 < nc; c0 += col_block) {
-        int64_t cur_c = (c0 + col_block <= nc) ? col_block : (nc - c0);
-        for (int64_t r0 = 0; r0 < nr; r0 += row_block) {
-            int64_t cur_r = (r0 + row_block <= nr) ? row_block : (nr - r0);
-            const void * vy_r = (const uint8_t *)vy + r0 * n;
-            for (int64_t c = 0; c < cur_c; ++c) {
-                const int64_t col = c0 + c;
-                float * s_col = s + col;
-                const void * vx_col = (const uint8_t *)vx + col * n / 4;
-                ggml_vec_dot_i2_i8_s(n, s_col + r0 * bs, bs, vx_col, n, vy_r, n, cur_r);
-            }
-        }
+    // Non-AVX2 fallback with the same contract as the AVX2 code above:
+    // s[col * bs + row] = sum_k code(row, k) * y(col, k), where row indexes
+    // the nc weight rows (n/4 bytes each) and col the nr activation columns
+    // (n bytes each). ggml_vec_dot_i2_i8_s computes nc consecutive weight
+    // rows against one activation column.
+    for (int64_t col = 0; col < nr; col++) {
+        ggml_vec_dot_i2_i8_s(n, s + col * bs, 0, vx, n, (const int8_t *)vy + col * n, 0, nc);
     }
-#else
-    for (int64_t r0 = 0; r0 < nr; r0 += row_block) {
-        int64_t cur_r = (r0 + row_block <= nr) ? row_block : (nr - r0);
-        const void * vy_row = (const uint8_t *)vy + r0 * n;
-        for (int64_t c0 = 0; c0 < nc; c0 += col_block) {
-            int64_t cur_c = (c0 + col_block <= nc) ? col_block : (nc - c0);
-            for (int64_t r = 0; r < cur_r; ++r) {
-                const int64_t row = r0 + r;
-                float * s_row = s + row * bs;
-                const void * vy_cur = (const uint8_t *)vy_row + r * n;
-                const void * vx_c = (const uint8_t *)vx + c0 * n / 4;
-                ggml_vec_dot_i2_i8_s(n, s_row + c0, bs, vx_c, n, vy_cur, n, cur_c);
-            }
-        }
-    }
-#endif
 #endif // __AVX2__
 }
 
diff --git a/ggml/src/ggml-cpu/quants.c b/ggml/src/ggml-cpu/quants.c
index 5264d01..6a21e89 100644
--- a/ggml/src/ggml-cpu/quants.c
+++ b/ggml/src/ggml-cpu/quants.c
@@ -1477,17 +1477,29 @@ static void ggml_vec_dot_i2_i8_s_1x1(int n, float * s, size_t bs, const void * v
         s[row] = (float)sumi;
     }
 #else
-    // Scalar fallback
+    // Scalar fallback with the same result as the AVX2 code above:
+    // - I2_S packs 128 weights in 32 bytes; byte gp of a block holds weights
+    //   gp, gp+32, gp+64 and gp+96 in bits 7-6, 5-4, 3-2 and 1-0 (the layout
+    //   of dequantize_row_i2_s and quantize_i2_s);
+    // - the 2-bit codes are used unsigned (0, 1, 2); the caller subtracts the
+    //   activation sum to map them to -1, 0, +1;
+    // - row r of x starts at r * bx / 4 bytes.
     const uint8_t * x = (const uint8_t *)vx;
-    const int8_t * y  = (const int8_t *)vy;
-    static const int map2bit[4] = { -1, 0, 1, 0 };
+    const int8_t  * y = (const int8_t *)vy;
+    const int nb = n / 128;
     for (int row = 0; row < nrc; row++) {
+        const uint8_t * x_row = x + row * bx / 4;
         int32_t sum = 0;
-        for (int i = 0; i < n; i++) {
-            int byte_idx = i / 4;
-            int bit_pos = 6 - 2 * (i % 4);
-            int w = map2bit[(x[row * (n/4) + byte_idx] >> bit_pos) & 0x03];
-            sum += w * y[i];
+        for (int b = 0; b < nb; b++) {
+            const uint8_t * px = x_row + b * 32;
+            const int8_t  * py = y + b * 128;
+            for (int gp = 0; gp < 32; gp++) {
+                const uint8_t byte = px[gp];
+                sum += ((byte >> 6) & 0x03) * py[gp];
+                sum += ((byte >> 4) & 0x03) * py[gp + 32];
+                sum += ((byte >> 2) & 0x03) * py[gp + 64];
+                sum += ( byte       & 0x03) * py[gp + 96];
+            }
         }
         s[row] = (float)sum;
     }
