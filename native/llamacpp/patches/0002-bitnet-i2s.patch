 // ====================== BitNet I2_S quantization functions ======================
 
+// Reference (scalar) code, moved here from ggml-cpu/quants.c: ggml.c uses
+// both functions (type traits, ggml_quantize_chunk), and ggml-base cannot
+// link against a CPU backend DLL (GGML_BACKEND_DL on Windows).
+void dequantize_row_i2_s(const uint8_t * x, float * y, int64_t n, const float i2_scale) {
+    static const float map2bit[4] = { -1.0f, 0.0f, 1.0f, 0.0f };
+    int64_t done = 0;
+    while (done < n) {
+        int64_t cols0 = MIN(32, n - done - 0*32);
+        int64_t cols1 = MIN(32, n - done - 1*32);
+        int64_t cols2 = MIN(32, n - done - 2*32);
+        int64_t cols3 = MIN(32, n - done - 3*32);
+        for (int gp = 0; gp < 32; gp++) {
+            uint8_t byte = x[(done/4) + gp];
+            uint8_t c0 = (byte >> 6) & 0x03;
+            uint8_t c1 = (byte >> 4) & 0x03;
+            uint8_t c2 = (byte >> 2) & 0x03;
+            uint8_t c3 = (byte >> 0) & 0x03;
+            if (gp < cols0) y[done + 0*32 + gp] = i2_scale * map2bit[c0];
+            if (gp < cols1) y[done + 1*32 + gp] = i2_scale * map2bit[c1];
+            if (gp < cols2) y[done + 2*32 + gp] = i2_scale * map2bit[c2];
+            if (gp < cols3) y[done + 3*32 + gp] = i2_scale * map2bit[c3];
+        }
+        done += 128;
+    }
+}
+
+// Quantizes a whole tensor (nrow rows) to I2_S. The weights must already be
+// ternary, {-s, 0, +s} with one s for the tensor, as the BitNet b1.58
+// converters write them. Codes 0/1/2 (-1/0/+1) are packed 128 weights per 32
+// bytes, byte gp holding weights gp, gp+32, gp+64 and gp+96 in bits 7-6, 5-4,
+// 3-2 and 1-0, as dequantize_row_i2_s and the kernels read them. The scale s
+// (the largest absolute value) follows as a float in the last 32 bytes.
+size_t quantize_i2_s(const float * src, void * dst, int64_t nrow, int64_t n_per_row, const float * quant_weights) {
+    (void)quant_weights;
+    const int64_t n = nrow * n_per_row;
+    GGML_ASSERT(n % 128 == 0);
+
+    float scale = 0.0f;
+    for (int64_t i = 0; i < n; i++) {
+        scale = MAX(scale, fabsf(src[i]));
+    }
+    const float threshold = scale / 2;
+
+    uint8_t * q = (uint8_t *) dst;
+    for (int64_t base = 0; base < n; base += 128) {
+        for (int gp = 0; gp < 32; gp++) {
+            uint8_t byte = 0;
+            for (int k = 0; k < 4; k++) {
+                const float v = src[base + 32*k + gp];
+                const uint8_t code = v > threshold ? 2 : (v < -threshold ? 0 : 1);
+                byte |= code << (6 - 2*k);
+            }
+            q[base/4 + gp] = byte;
+        }
+    }
+
+    memset(q + n/4, 0, 32);
+    memcpy(q + n/4, &scale, sizeof(scale));
+
+    return n/4 + 32;
+}
+
