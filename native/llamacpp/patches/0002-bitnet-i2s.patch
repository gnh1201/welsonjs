diff --git a/ggml/src/ggml-cpu/gemm-config.h b/ggml/src/ggml-cpu/gemm-config.h
new file mode 100644
index 0000000..332e446
--- /dev/null
+++ b/ggml/src/ggml-cpu/gemm-config.h
@@ -0,0 +1,58 @@
+// gemm-config.h from microsoft/BitNet 0b341e582afbf9e1011f24744b554c96a3477eb5
+// (include/gemm-config.h, MIT License, Copyright (c) Microsoft Corporation),
+// copied into the fork so that the I2_S kernels (ggml-cpu-i2s.c) build
+// without the BitNet repository. BitNet's utils/tune_gemm_config.py rewrites
+// this file to tune the block sizes.
+
+#define ACT_PARALLEL
+#if defined(__AVX__) || defined(__AVX2__) || defined(__AVX512F__) || defined(__SSSE3__)
+#if defined(ACT_PARALLEL)
+    #define ROW_BLOCK_SIZE 4
+    #define COL_BLOCK_SIZE 128
+    #define PARALLEL_SIZE 4
+#else
+    #define ROW_BLOCK_SIZE 128
+    #define COL_BLOCK_SIZE 32
+    #define PARALLEL_SIZE 8
+#endif // ACT_PARALLEL
+#elif defined(__ARM_NEON)
+#if defined(__ARM_FEATURE_DOTPROD)
+#if defined(ACT_PARALLEL)
+    #define ROW_BLOCK_SIZE 8
+    #define COL_BLOCK_SIZE 256
+    #define PARALLEL_SIZE 8
+#else
+    #define ROW_BLOCK_SIZE 64
+    #define COL_BLOCK_SIZE 16
+    #define PARALLEL_SIZE 2
+#endif // ACT_PARALLEL
+#else
+#if defined(ACT_PARALLEL)
+    #define ROW_BLOCK_SIZE 8
+    #define COL_BLOCK_SIZE 256
+    #define PARALLEL_SIZE 4
+#else
+    #define ROW_BLOCK_SIZE 128
+    #define COL_BLOCK_SIZE 32
+    #define PARALLEL_SIZE 4
+#endif // ACT_PARALLEL
+#endif // __ARM_FEATURE_DOTPROD
+#endif // __AVX__
+
+
+// Added for WelsonJS: a CPU variant without AVX/SSSE3 (the baseline x64
+// variant of GGML_CPU_ALL_VARIANTS, and every MSVC variant below AVX, since
+// MSVC does not define __SSSE3__) reaches none of the cases above, but the
+// non-AVX2 path of ggml-cpu-i2s.c uses ROW_BLOCK_SIZE and COL_BLOCK_SIZE.
+// Use the x86 values.
+#ifndef ROW_BLOCK_SIZE
+#if defined(ACT_PARALLEL)
+    #define ROW_BLOCK_SIZE 4
+    #define COL_BLOCK_SIZE 128
+    #define PARALLEL_SIZE 4
+#else
+    #define ROW_BLOCK_SIZE 128
+    #define COL_BLOCK_SIZE 32
+    #define PARALLEL_SIZE 8
+#endif // ACT_PARALLEL
+#endif // ROW_BLOCK_SIZE
