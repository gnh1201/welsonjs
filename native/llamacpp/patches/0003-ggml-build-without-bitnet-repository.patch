From: WelsonJS
Subject: [PATCH] ggml : build without the BitNet repository unless TL1/TL2 is on

This fork is the llama.cpp submodule of microsoft/BitNet and uses files from
the BitNet repository, which are not in the fork:

  - ../../../../src/ggml-bitnet-lut.cpp and ../../../../include (ggml-bitnet.h,
    bitnet-lut-kernels.h): only used by the TL1/TL2 lookup-table kernels
    (GGML_BITNET_ARM_TL1, GGML_BITNET_X86_TL2). Every use of ggml-bitnet.h is
    already inside #if defined(GGML_BITNET_ARM_TL1) ||
    defined(GGML_BITNET_X86_TL2), but the CMake files add these paths
    unconditionally. Add them only when TL1 or TL2 is on.
  - gemm-config.h: the block sizes of the I2_S kernels (ggml-cpu-i2s.c), which
    are part of the fork. Copy it from BitNet
    0b341e582afbf9e1011f24744b554c96a3477eb5 into ggml/src/ggml-cpu, next to
    ggml-cpu-i2s.c, and add defaults for CPU variants that reach none of its
    cases (the baseline x64 variant of GGML_CPU_ALL_VARIANTS, and MSVC
    variants below AVX, since MSVC does not define __SSSE3__); the non-AVX2
    path of ggml-cpu-i2s.c uses ROW_BLOCK_SIZE and COL_BLOCK_SIZE.

With TL1/TL2 off the fork then builds on its own (the "Clang or GCC is
required" check is in BitNet's CMake, not in the fork).

Apply with: git -c core.autocrlf=false apply <this file>

diff --git a/ggml/src/CMakeLists.txt b/ggml/src/CMakeLists.txt
index 94d0f0f..972459e 100644
--- a/ggml/src/CMakeLists.txt
+++ b/ggml/src/CMakeLists.txt
@@ -213,7 +213,12 @@ set_target_properties(ggml-base PROPERTIES
     SOVERSION ${GGML_VERSION_MAJOR}
 )
 
-target_include_directories(ggml-base PRIVATE . ../../../../include)
+target_include_directories(ggml-base PRIVATE .)
+# bitnet.cpp's TL1/TL2 kernels live in the BitNet repository that contains
+# this fork (../../../../include); the I2_S kernels are part of the fork.
+if (GGML_BITNET_ARM_TL1 OR GGML_BITNET_X86_TL2)
+    target_include_directories(ggml-base PRIVATE ../../../../include)
+endif()
 if (GGML_BACKEND_DL)
     target_compile_definitions(ggml-base PUBLIC GGML_BACKEND_DL)
 endif()
diff --git a/ggml/src/ggml-cpu/CMakeLists.txt b/ggml/src/ggml-cpu/CMakeLists.txt
index fd5ba99..55f0f5a 100644
--- a/ggml/src/ggml-cpu/CMakeLists.txt
+++ b/ggml/src/ggml-cpu/CMakeLists.txt
@@ -53,11 +53,18 @@ function(ggml_add_cpu_backend_variant_impl tag_name)
         ggml-cpu/vec.cpp
         ggml-cpu/ops.h
         ggml-cpu/ops.cpp
-        ../../../../src/ggml-bitnet-lut.cpp
         )
 
     target_compile_features(${GGML_CPU_NAME} PRIVATE c_std_11 cxx_std_17)
-    target_include_directories(${GGML_CPU_NAME} PRIVATE . ggml-cpu ../../../../include)
+    target_include_directories(${GGML_CPU_NAME} PRIVATE . ggml-cpu)
+
+    # bitnet.cpp's TL1/TL2 kernels live in the BitNet repository that contains
+    # this fork (../../../../src and include); the I2_S kernels
+    # (ggml-cpu-i2s.c) are part of the fork and need neither.
+    if (GGML_BITNET_ARM_TL1 OR GGML_BITNET_X86_TL2)
+        list (APPEND GGML_CPU_SOURCES ../../../../src/ggml-bitnet-lut.cpp)
+        target_include_directories(${GGML_CPU_NAME} PRIVATE ../../../../include)
+    endif()
 
     if (APPLE AND GGML_ACCELERATE)
         find_library(ACCELERATE_FRAMEWORK Accelerate)
diff --git a/ggml/src/ggml-cpu/gemm-config.h b/ggml/src/ggml-cpu/gemm-config.h
new file mode 100644
index 0000000..332e446
--- /dev/null
+++ b/ggml/src/ggml-cpu/gemm-config.h
@@ -0,0 +1,58 @@
+// gemm-config.h from microsoft/BitNet 0b341e582afbf9e1011f24744b554c96a3477eb5
+// (include/gemm-config.h, MIT License, Copyright (c) Microsoft Corporation),
+// copied into the fork so that the I2_S kernels (ggml-cpu-i2s.c) build
+// without the BitNet repository. BitNet's utils/tune_gemm_config.py rewrites
+// this file to tune the block sizes.
+
+#define ACT_PARALLEL
+#if defined(__AVX__) || defined(__AVX2__) || defined(__AVX512F__) || defined(__SSSE3__)
+#if defined(ACT_PARALLEL)
+    #define ROW_BLOCK_SIZE 4
+    #define COL_BLOCK_SIZE 128
+    #define PARALLEL_SIZE 4
+#else
+    #define ROW_BLOCK_SIZE 128
+    #define COL_BLOCK_SIZE 32
+    #define PARALLEL_SIZE 8
+#endif // ACT_PARALLEL
+#elif defined(__ARM_NEON)
+#if defined(__ARM_FEATURE_DOTPROD)
+#if defined(ACT_PARALLEL)
+    #define ROW_BLOCK_SIZE 8
+    #define COL_BLOCK_SIZE 256
+    #define PARALLEL_SIZE 8
+#else
+    #define ROW_BLOCK_SIZE 64
+    #define COL_BLOCK_SIZE 16
+    #define PARALLEL_SIZE 2
+#endif // ACT_PARALLEL
+#else
+#if defined(ACT_PARALLEL)
+    #define ROW_BLOCK_SIZE 8
+    #define COL_BLOCK_SIZE 256
+    #define PARALLEL_SIZE 4
+#else
+    #define ROW_BLOCK_SIZE 128
+    #define COL_BLOCK_SIZE 32
+    #define PARALLEL_SIZE 4
+#endif // ACT_PARALLEL
+#endif // __ARM_FEATURE_DOTPROD
+#endif // __AVX__
+
+
+// Added for WelsonJS: a CPU variant without AVX/SSSE3 (the baseline x64
+// variant of GGML_CPU_ALL_VARIANTS, and every MSVC variant below AVX, since
+// MSVC does not define __SSSE3__) reaches none of the cases above, but the
+// non-AVX2 path of ggml-cpu-i2s.c uses ROW_BLOCK_SIZE and COL_BLOCK_SIZE.
+// Use the x86 values.
+#ifndef ROW_BLOCK_SIZE
+#if defined(ACT_PARALLEL)
+    #define ROW_BLOCK_SIZE 4
+    #define COL_BLOCK_SIZE 128
+    #define PARALLEL_SIZE 4
+#else
+    #define ROW_BLOCK_SIZE 128
+    #define COL_BLOCK_SIZE 32
+    #define PARALLEL_SIZE 8
+#endif // ACT_PARALLEL
+#endif // ROW_BLOCK_SIZE
