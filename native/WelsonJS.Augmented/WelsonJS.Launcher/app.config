<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="ResourceServerAllowOrigins" value=""/>
    <!-- The launcher's API key (16 characters or more): other software on this machine may use
         the APIs that accept it (now the OpenAI-compatible API, /v1/...) by sending
         "Authorization: Bearer <key>". Empty: only the launcher, its pages and local scripts.
         The value below is an example key, which is public: replace it with your own. -->
    <add key="ResourceServerApiKey" value="oss@catswords.re.kr"/>
    <add key="ResourceServerAutoStart" value="true"/>
    <add key="ResourceServerPrefix" value="http://localhost:3000/"/>
    <add key="RepositoryUrl" value="https://github.com/gnh1201/welsonjs"/>
    <add key="ChromiumDevToolsTimeout" value="5"/>
    <add key="ChromiumExecutablePath" value="msedge.exe"/>
    <add key="ChromiumAppMode" value="true"/>
    <!-- DNS servers of the DNS query tool, separated by commas: the first is asked first, the others are
         fallbacks when it does not answer, fails or refuses. -->
    <add key="DnsServerAddress" value="1.1.1.1,8.8.8.8"/>
    <add key="BlobStoragePrefix" value="https://catswords.blob.core.windows.net/welsonjs/"/>
    <add key="BlobConfigUrl" value="https://catswords.blob.core.windows.net/welsonjs/blob.config.xml"/>
    <add key="HttpClientTimeout" value="90"/>
    <!-- API key of Criminal IP (criminalip in the blob config; https://www.criminalip.io/). -->
    <add key="IpQueryApiKey" value=""/>
    <!-- API key of AbuseIPDB (abuseipdb in the blob config; https://www.abuseipdb.com/). -->
    <add key="IpQueryApiKey2" value=""/>
    <add key="AppSignalApiPrefix" value="https://appsignal-endpoint.net/logs/json"/>
    <add key="AppSignalApiKey" value="ls-9e36eee5-ba13-45cd-a7d1-b19f39329173"/>
    <add key="DateTimeFormat" value="yyyy-MM-dd HH:mm:ss"/>
    <add key="AssemblyBaseUrl" value="https://catswords.blob.core.windows.net/welsonjs/packages"/>
    <add key="AssemblyIntegrityUrl" value="https://catswords.blob.core.windows.net/welsonjs/integrity.config.xml"/>
    <add key="IntegrityHashCurl" value="5ac5ffa5458c1b10164957f82c1d6d1b8d134598e4c2bcc65083a2b189e18d3d"/>
    <!-- llama.cpp runs as one llama-server in router mode with models from %APPDATA%\WelsonJS: each folder there
         that holds a .gguf file is a model named after the folder (the installer component). -->
    <!-- Models the editor offers as Local AI (comma-separated, in toggle order); requests name their model. -->
    <add key="LlamaCppModels" value="hy_mt2_1_8b_1_25bit,frognano_4b_2609,bitnet_b1_58_2b_4t"/>
    <!-- Qwen3Guard model of the LLM guard. -->
    <add key="LlmGuardModel" value="qwen3guard_06b"/>
    <!-- Models loaded at once; the least recently used one is unloaded beyond this (0 = no limit). Three keep
         a translated model, the translation model and the LLM guard loaded together. -->
    <add key="LlamaCppModelsMax" value="3"/>
    <!-- Models that work best in English (comma-separated): their user messages are translated into English
         with LlamaCppTranslationModel, and they are asked to reply in the system language when possible. -->
    <add key="LlamaCppTranslatedModels" value="frognano_4b_2609,bitnet_b1_58_2b_4t"/>
    <add key="LlamaCppTranslationModel" value="hy_mt2_1_8b_1_25bit"/>
    <!-- Context size of every model instance. -->
    <add key="LlamaCppContextSize" value="8192"/>
    <!-- Embedding models (llama-server in embedding mode, one per model) are read from
         %APPDATA%\WelsonJS\llamacpp_embedding_models: each folder there with a .gguf file is a model. -->
    <!-- Embedding servers running at once; the least recently used idle one is stopped beyond this. -->
    <add key="LlamaCppEmbeddingModelsMax" value="1"/>
    <!-- Context of an embedding server, which is also the longest input in tokens (up to 8192 for EmbeddingGemma 2). -->
    <add key="LlamaCppEmbeddingContextSize" value="2048"/>
    <!-- CrispEmbed runs one crispembed-server per model, with models from %APPDATA%\WelsonJS\crispembed_models:
         each folder there that holds a .gguf file is a model named after the folder (the installer component). -->
    <!-- Models offered first (comma-separated); requests name their model. -->
    <add key="CrispEmbedModels" value="embeddinggemma_2_typed_decision"/>
    <!-- Typed-decision models (comma-separated): they answer /v1/decisions and /crispembed/decide only.
         Every other CrispEmbed model is an embedding model for /v1/embeddings and /crispembed/embed. -->
    <add key="CrispEmbedDecisionModels" value="embeddinggemma_2_typed_decision"/>
    <!-- CrispEmbed servers running at once; the least recently used idle one is stopped beyond this. -->
    <add key="CrispEmbedModelsMax" value="2"/>
  </appSettings>
  <startup>
    
  <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/></startup>
  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
    </assemblyBinding>
  </runtime>
</configuration>
