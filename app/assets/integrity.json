  },
  "integrity": {
    "format": "Subresource Integrity: \"<algorithm>-<base64 digest>\"",
    "eol": "Digests are computed over the repository bytes, which equal the bytes served by \"url\". Git may check the text assets out with CRLF line endings (core.autocrlf); normalize CRLF to LF before verifying a local copy."
  },
